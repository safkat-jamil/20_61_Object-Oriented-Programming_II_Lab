@model StudentManagementSystem.Models.Academic.Routine
@{
    ViewData["Title"] = "Add Class Routine";
}
<form asp-action="AddClassRoutine" method="post">
    <div class="mb-3">
        <label>Course</label>
        <select asp-for="CourseId" asp-items="ViewBag.Courses" class="form-select"></select>
    </div>
    <div class="mb-3">
        <label>Date & Time</label>
        <input asp-for="ScheduledAt" type="datetime-local" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
</form>
