<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Student Management System</title>
    <link rel="icon" href="~/images/BOU_Logo.png" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header class="bg-light py-3 border-bottom fixed-top">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
                <img src="~/images/BOU_Logo.png" style="max-height:50px;" alt="Logo" />
                <span class="h4 ms-2">Student Management System</span>

                <button class="navbar-toggler d-md-none ms-3" type="button" data-bs-toggle="collapse" data-bs-target="#sidebar">
                    <span class="navbar-toggler-icon"></span>
                </button>
            </div>
            <div class="d-flex align-items-center">
                <a asp-action="Index" class="btn btn-outline-primary me-2">🏠 Home</a>
                <div class="dropdown me-2">
                    <button class="btn btn-outline-success dropdown-toggle" data-bs-toggle="dropdown">🎓 Student Portal</button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" asp-action="StudentRegistration">📋 Student Registration</a></li>
                        <li><a class="dropdown-item" asp-action="StudentLogin">🔐 Student Login</a></li>
                    </ul>
                </div>
                <a asp-action="FacultyLogin" class="btn btn-outline-info me-2">👨‍🏫 Faculty Login</a>

                @if (Context.Session.GetString("IsAdmin") == "True")
                {
                    <a asp-action="ApproveStudents" class="btn btn-outline-danger me-2">🧑‍💼 Admin Panel</a>
                    <a asp-action="AdminLogout" class="btn btn-outline-secondary">Logout</a>
                }
                else
                {
                    <a asp-action="AdminLogin" class="btn btn-outline-danger">🧑‍💼 Admin Login</a>
                }
            </div>
        </div>
    </header>

    <div class="container-fluid flex-fill" style="padding-top: 80px;">
        <div class="row">
            @{
                var userRole = Context.Session.GetString("UserRole");
            }

            @if (!string.IsNullOrEmpty(userRole))
            {
                <nav id="sidebar" class="sidebar col-md-2 collapse d-md-block">
                    <ul class="nav flex-column">
                        @if (userRole == "Student")
                        {
                            <li class="nav-item mb-2"><a class="nav-link" asp-controller="Home" asp-action="Dashboard">🏠 Dashboard</a></li>
                            <li class="nav-item mb-2"><a class="nav-link" asp-controller="Notification" asp-action="Index">🔔 Notifications</a></li>
                            <li class="nav-item mb-2"><a class="nav-link" asp-controller="Student" asp-action="CourseRegistration">📝 Apply Course</a></li>
                            <li class="nav-item mb-2"><a class="nav-link" asp-controller="Student" asp-action="MyRegistrations">📄 My Registrations</a></li>
                            <li class="nav-item mb-2"><a class="nav-link" asp-controller="Student" asp-action="ViewRoutine">📅 Routine</a></li>
                            <li class="nav-item mb-2"><a class="nav-link" asp-controller="Student" asp-action="PayFee">💳 Pay Fee</a></li>
                            <li class="nav-item mb-2"><a class="nav-link" asp-controller="Student" asp-action="StudyMaterials">📚 Study Material</a></li>
                            <li class="nav-item mb-2"><a class="nav-link" asp-controller="Student" asp-action="ViewMarks">📊 Marks</a></li>
                            <li class="nav-item mb-2"><a class="nav-link" asp-controller="Student" asp-action="Progress">📈 Progress</a></li>
                            <li class="nav-item mb-2"><a class="nav-link" asp-controller="Home" asp-action="ChangePassword">🗝 Change Password</a></li>
                            <li class="nav-item mb-2"><a class="nav-link text-danger" asp-controller="Home" asp-action="Logout">🚪 Logout</a></li>
                        }
                        else if (userRole == "Faculty")
                        {
                            <li class="nav-item mb-2"><a class="nav-link" asp-controller="Home" asp-action="FacultyDashboard">🏠 Dashboard</a></li>
                            <li class="nav-item mb-2"><a class="nav-link" asp-controller="Notification" asp-action="Index">🔔 Notifications</a></li>
                            <li class="nav-item mb-2"><a class="nav-link" asp-controller="Faculty" asp-action="ViewRoutine">📅 Routine</a></li>
                            <li class="nav-item mb-2"><a class="nav-link" asp-controller="Faculty" asp-action="AddStudyMaterial">➕ Add Study Material</a></li>
                            <li class="nav-item mb-2"><a class="nav-link" asp-controller="Faculty" asp-action="AddAttendance">📋 Add Attendance</a></li>
                            <li class="nav-item mb-2"><a class="nav-link" asp-controller="Faculty" asp-action="AddMarks">🖊 Add Marks</a></li>
                            <li class="nav-item mb-2"><a class="nav-link" asp-controller="Home" asp-action="ChangePassword">🗝 Change Password</a></li>
                            <li class="nav-item mb-2"><a class="nav-link text-danger" asp-controller="Home" asp-action="FacultyLogout">🚪 Logout</a></li>
                        }
                        else if (userRole == "Admin")
                        {
                            <li class="nav-item mb-2"><a class="nav-link" asp-controller="Home" asp-action="AdminDashboard">🏠 Dashboard</a></li>
                            <li class="nav-item mb-2"><a class="nav-link" asp-controller="Notification" asp-action="Index">🔔 Notifications</a></li>
                            <li class="nav-item mb-2"><a class="nav-link" asp-controller="Home" asp-action="ApproveStudents">⏳ Pending Students</a></li>
                            <li class="nav-item mb-2"><a class="nav-link" asp-controller="Admin" asp-action="ManageFaculty">👨‍🏫 Manage Faculty</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="ManageCourses">📚 Courses</a></li>
                            <li class="nav-item mb-2"><a class="nav-link" asp-controller="Admin" asp-action="ClassRoutine">📅 Class Routine</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="FeeSettings">💰 Fee Settings</a></li>
                            <li class="nav-item mb-2"><a class="nav-link" asp-controller="Admin" asp-action="ExamRoutine">📝 Exam Routine</a></li>
                            <li class="nav-item mb-2"><a class="nav-link" asp-controller="Admin" asp-action="ExamCommittee">👥 Exam Committee</a></li>
                            <li class="nav-item mb-2"><a class="nav-link text-danger" asp-controller="Home" asp-action="AdminLogout">🚪 Logout</a></li>
                        }
                    </ul>
                </nav>
            }

            <!-- MAIN CONTENT -->
            <main class="col-md-@(string.IsNullOrEmpty(userRole) ? "12" : "10") p-4">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- FOOTER -->
    <footer class="footer bg-light py-3 border-top mt-auto">
        <div class="d-flex justify-content-between align-items-center flex-column flex-md-row text-center text-md-start px-5">
            <div class="text-start" style="color: darkgray;">&copy; 2025</div>
            <div class="text-center">Object Oriented Programming II (CSE31P8) Project</div>
            <div class="text-end" style="color: darkgray;">
                Safkat Jamil (Imon) [20-0-52-801-061]<br />
                Md. Al Amin Miah [20-0-52-801-009], &emsp; S. M. Mozammal Hossain Imon [20-0-52-801-033]
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
