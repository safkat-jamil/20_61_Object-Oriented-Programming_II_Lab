@model StudentManagementSystem.Models.Academic.FeeSetting
@{
    ViewData["Title"] = Model.Id == 0 ? "Add Fee" : "Edit Fee";
}
<h2>@ViewData["Title"]</h2>
<form asp-action="@(Model.Id == 0 ? "CreateFee" : "EditFee")" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label asp-for="Semester" class="form-label"></label>
        <input asp-for="Semester" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="ExamYear" class="form-label"></label>
        <input asp-for="ExamYear" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="RegistrationFee" class="form-label"></label>
        <input asp-for="RegistrationFee" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="ImprovementFee" class="form-label"></label>
        <input asp-for="ImprovementFee" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
</form>
