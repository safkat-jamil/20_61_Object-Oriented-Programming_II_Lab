@model StudentManagementSystem.Models.AdminLoginViewModel
@{
    ViewData["Title"] = "Admin Login";
}

<div class="registration-container mx-auto mt-5 p-4">
    <h2 class="text-center mb-4">Admin Login</h2>
    <form asp-action="AdminLogin" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Username" class="form-label">Username</label>
            <input asp-for="Username" class="form-control" required />
            <span asp-validation-for="Username" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label">Password</label>
            <div class="input-group">
                <input asp-for="Password" id="admin-password" type="password" class="form-control" required />
                <button type="button"
                        class="btn btn-outline-secondary password-toggle-btn"
                        data-target="admin-password">
                    👁️
                </button>
            </div>
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="mb-3">
            @await Html.PartialAsync("_CaptchaPartial", Model)
        </div>

        <div class="text-center">
            <button type="submit" class="btn btn-lg">Login</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
