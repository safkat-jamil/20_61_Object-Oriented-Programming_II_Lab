@model IEnumerable<StudentManagementSystem.Models.Academic.Student>
@{
    ViewData["Title"] = "Pending Approvals";
}
<h2 class="mb-4">🧾 Pending Student Approvals</h2>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Photo</th>
            <th>Student ID</th>
            <th>Name</th>
            <th>Date of Birth</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>
                    <img src="~/uploads/@s.PhotoFileName"
                         alt="@s.FirstName"
                         class="img-thumbnail"
                         style="max-height:60px;" />
                </td>
                <td>@s.StudentId</td>
                <td>@s.FirstName @s.MiddleName @s.LastName</td>
                <td>@s.DateOfBirth.ToString("dd MMMM yyyy")</td>
                <td>
                    <a asp-action="ViewStudent"
                       asp-route-id="@s.StudentId"
                       class="btn btn-sm btn-info me-1">
                        View Details
                    </a>

                    <form asp-action="Approve" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@s.StudentId" />
                        <button type="submit" class="btn btn-sm btn-success me-1">
                            Approve
                        </button>
                    </form>

                    <form asp-action="Deny" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@s.StudentId" />
                        <button type="submit" class="btn btn-sm btn-danger">
                            Deny
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
